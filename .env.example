VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
PARSER_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Секрет для /api/update-exchange-rate (ежедневное обновление курса ЦБ). Vercel Cron
# сам шлёт его заголовком "Authorization: Bearer <CRON_SECRET>". Без него endpoint закрыт.
CRON_SECRET=
FINALIZE_SECRET=
# Claude Haiku (Anthropic) — первый в цепочке ИИ-провайдеров. Без ключа цепочка
# работает как раньше (Gemini -> Groq -> ...). Только на сервере, без префикса VITE_.
ANTHROPIC_API_KEY=
# Название модели вынесено в переменную; если не задана — claude-haiku-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Необязательные настройки разбора объявлений (значения по умолчанию в скобках) ---
# Время на ВСЮ цепочку ИИ-провайдеров для одного объявления, мс (25000).
# Должно быть меньше maxDuration функции на Vercel.
# AI_TOTAL_BUDGET_MS=25000
# Таймаут одного обращения к провайдеру, мс (20000)
# AI_TIMEOUT_MS=20000
# Попыток на провайдера при пустом/невалидном ответе, 1..3 (2)
# AI_MAX_ATTEMPTS=2
# Паузы между повторами, мс (800,1800)
# AI_RETRY_DELAYS_MS=800,1800
# Писать этаж/этажность жилья в cardss.floor / total_floors.
# Включать ТОЛЬКО после применения sql/optional_add_card_floor.sql (иначе запись
# карточки сначала упадёт на неизвестной колонке и сработает безопасный откат).
# CARD_FLOOR_COLUMNS=1
# Максимально допустимое изменение курса USD/UZS за одно обновление, % (20).
# Более резкий скачок считается подозрительным и не записывается.
# FX_MAX_CHANGE_PCT=20
